# ════════════════════════════════════════════════════════════════════════════════════════════
# Tikisse — variables d'environnement. Copier en `.env` (jamais commité) en local, ou les saisir
# dans les réglages de l'hébergeur. Guide complet : docs/SUPABASE_SETUP.md.
#
# Deux familles :
#  - SERVEUR : lues par l'API au démarrage. Restent sur le serveur.
#  - EXPO_PUBLIC_* : copiées DANS l'application au moment du build (EAS / export web). Publiques par
#    nature : n'y mettre que ce qui peut l'être (jamais la clé service_role).
# ════════════════════════════════════════════════════════════════════════════════════════════

# ─── Serveur : base de données (Supabase → Project Settings → Database → Connection string →
#     « Transaction pooler », port 6543) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_POOL_MAX=10
# Migrations (Render, avant chaque mise en service) : adresse « Session pooler », port 5432.
# DATABASE_MIGRATION_URL=postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ─── Serveur : Supabase (Project Settings → API) ───────────────────────────────────────────
SUPABASE_URL=https://<ref>.supabase.co
# Clé « service_role » : accès total au projet. Serveur uniquement, jamais dans l'application.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=tikisse-files
# Jeton personnel Supabase (Account → Access Tokens) : seulement pour pnpm supabase:setup / supabase:check
# depuis un poste ; jamais sur le serveur. À révoquer après la mise en service.
# SUPABASE_ACCESS_TOKEN=

# ─── Serveur : secrets propres à Tikisse (chacun : 32 caractères aléatoires au moins, distincts) ─
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Signature des sessions des utilisateurs. Le changer déconnecte tout le monde.
TIKISSE_SESSION_SECRET=
# Chiffrement des secrets de double authentification de la console. Le perdre oblige chaque admin
# à se réenrôler.
TIKISSE_ADMIN_TOTP_KEY=
# Déclenchement manuel des tâches planifiées (pnpm jobs:run).
CRON_SECRET=

# ─── Serveur : web et cookies ──────────────────────────────────────────────────────────────
# PORT=3000   (fourni par Render : ne pas le définir là-bas)
NODE_ENV=production
# Origines autorisées à appeler l'API depuis un navigateur, séparées par des virgules.
TIKISSE_ALLOWED_ORIGINS=https://app.tikisse.com,https://tikisse.com,https://www.tikisse.com,https://console.tikisse.com
# Domaine(s) où la console est servie à la racine (sinon sous /admin). Défaut : console.tikisse.com.
# TIKISSE_CONSOLE_HOSTS=console.tikisse.com
# Seulement si plusieurs sous-domaines doivent recevoir le cookie de session web.
# TIKISSE_COOKIE_DOMAIN=.tikisse.app

# ─── Serveur : connexion par SMS ───────────────────────────────────────────────────────────
# `sim` : code de simulation (TIKISSE_SIMULATION_OTP, défaut 730512) — tests uniquement.
# `real` : vrais SMS, envoyés par Supabase Auth (fournisseur SMS configuré dans Supabase).
TIKISSE_OTP_MODE=sim
# TIKISSE_SIMULATION_OTP=730512

# ─── Serveur : paiements YengaPay ──────────────────────────────────────────────────────────
YENGAPAY_MODE=test
YENGAPAY_API_KEY=
YENGAPAY_ORG_ID=
YENGAPAY_PROJECT_ID=
YENGAPAY_WEBHOOK_SECRET=
# YENGAPAY_BASE_URL=

# ─── Serveur : cartographie, suivi des erreurs ─────────────────────────────────────────────
MAPBOX_SECRET_ACCESS_TOKEN=
# TIKISSE_OSM_SEARCH_URL=
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=

# ─── Serveur : tâches planifiées ───────────────────────────────────────────────────────────
# `off` sur une instance qui ne doit pas les exécuter (les autres continuent).
# TIKISSE_SCHEDULER=off

# ─── Application (EXPO_PUBLIC_*, intégrées au build) ───────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=https://api.tikisse.com
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# Clé « anon » (publique par conception : la RLS protège les données).
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# `true` une fois le fournisseur SMS configuré dans Supabase Auth (avec TIKISSE_OTP_MODE=real).
EXPO_PUBLIC_ENABLE_SUPABASE_PHONE_AUTH=false
EXPO_PUBLIC_EAS_PROJECT_ID=
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# ─── Paiement Mobile Money dans l'application (rechargement du Wallet) ─────────────────────
# Prestataire des nouveaux paiements : ligdicash ou yengapay (défaut).
TIKISSE_DIRECT_PAYMENT_PROVIDER=yengapay
# LigdiCash (tableau de bord marchand → Intégration API) : clé d'API et jeton d'authentification.
# sandbox = test.ligdicash.com ; live = app.ligdicash.com. Rappel : https://api.tikisse.com/api/webhooks/ligdicash
LIGDICASH_MODE=sandbox
LIGDICASH_API_KEY=
LIGDICASH_AUTH_TOKEN=
